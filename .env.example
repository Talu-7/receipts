# Nebius Token Factory (Nemotron Nano / Super / Ultra). Get a key in the Nebius console.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# Exact model IDs are auto-resolved from /v1/models; override only if needed:
# NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

TAVILY_API_KEY=

# Where reproductions run: "local" (subprocess) or "nebius" (Serverless Jobs via the `nebius` CLI)
RECEIPTS_RUNNER=local
RECEIPTS_JOB_IMAGE=ghcr.io/YOUR_ORG/receipts-sandbox:latest
# Platforms are tied to REGIONS. Your project's region decides which one you can use:
#   gpu-l40s-a / gpu-l40s-d / gpu-h100-sxm : eu-north1
#   gpu-h200-sxm : eu-north1, eu-north2, eu-west1, us-central1
#   gpu-b200-sxm : us-central1 | gpu-b200-sxm-a : me-west1
#   gpu-b300-sxm : uk-south1, eu-west2, us-north1
# Check yours with:  nebius compute platform list
RECEIPTS_JOB_PLATFORM=gpu-l40s-a
# Optional (defaults to the smallest preset): e.g. 1gpu-8vcpu-32gb for gpu-l40s-a
# RECEIPTS_JOB_PRESET=
# RECEIPTS_JOB_EXTRA_ARGS=
# Nebius requires a job timeout between 1h and 168h
RECEIPTS_JOB_TIMEOUT=1h
# USD per job-hour for your platform/preset, used for the cost line in receipts
RECEIPTS_JOB_COST_PER_HOUR=0
RECEIPTS_MAX_PARALLEL=8
# --runner docker: runs RECEIPTS_JOB_IMAGE locally with docker run (hardened, see README)
# RECEIPTS_DOCKER_MEMORY=4g
# RECEIPTS_DOCKER_CPUS=2
# RECEIPTS_DOCKER_GPUS=0
# Optional for --runner nebius: CLI profile and explicit project
# RECEIPTS_NEBIUS_PROFILE=hackathon
# RECEIPTS_NEBIUS_PARENT_ID=project-xxxxxxxx
# Skip (as "inconclusive: not attempted") claims estimated to need more GPU-minutes than this
RECEIPTS_MAX_GPU_MIN=60
# Extra tokens given to reasoning models on top of each answer budget
RECEIPTS_REASONING_BUDGET=3000
RECEIPTS_OUT_DIR=out
